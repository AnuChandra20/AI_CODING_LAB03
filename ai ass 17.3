        "    'experience': [5, 3, 2, 1, 4, 5, 2, 3, 1, 6, 2, 1, 5, 7, 1, 3],\n",
        "    'employment_type': ['Full-time', 'Full-time', 'Contract', 'Full-time', 'Full-time', 'Full-time', 'Contract', 'Full-time', 'Full-time', 'Full-time', 'Contract', 'Full-time', 'Full-time', 'Full-time', 'Full-time', 'Full-time']\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Introduce some missing values\n",
        "df.loc[[1, 3, 6], 'salary'] = np.nan\n",
        "df.loc[[2, 5, 8], 'designation'] = np.nan\n",
        "df.loc[[0, 4, 9], 'experience'] = np.nan\n",
