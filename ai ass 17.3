        "# Introduce mixed case job titles\n",
        "df.loc[0, 'designation'] = 'manager'\n",
        "df.loc[4, 'designation'] = 'DEVELOPER'\n",
        "\n",
        "print(\"Original DataFrame with introduced issues:\")\n",
        "display(df)"
