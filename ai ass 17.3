      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Generate synthetic ride-sharing data\n",
        "np.random.seed(42)\n",
        "num_trips = 20\n",
        "\n",
        "data = {\n",
        "    'trip_id': list(range(1, num_trips // 2 + 1)) * 2, # Introduce duplicates\n",
        "    'pickup_location': [\n",
        "        'Downtown', 'Airport', 'Suburb A', 'downtown', 'Central Park',\n",
        "        'airport', 'Suburb B ', ' downtown', 'Financial District', 'Airport',\n",
        "        ' Downtown', 'suburb a', 'Central park', 'FINANCIAL DISTRICT', 'Airport',\n",
        "        'Suburb B', 'Downtown', 'Airport', 'Suburb A', 'Central Park'\n",
        "    ],\n",
        "    'drop_location': [\n",
        "        'Uptown', 'Hotel Zone', 'Office Park', 'uptown', 'Museum District',\n",
        "        'hotel Zone', ' Residential', ' uptown', 'Shopping Mall', 'Hotel Zone',\n",
        "        ' Uptown', 'office park', 'Museum District', 'SHOPPING MALL', 'Hotel Zone',\n",
        "        'Residential', 'Uptown', 'Hotel Zone', 'Office Park', 'Museum District'\n",
        "    ],\n",
        "    'fare_amount': np.random.normal(25, 10, num_trips).round(2),\n",
        "    'driver_rating': np.random.uniform(2.5, 5.0, num_trips).round(1),\n",
        "    'trip_timestamp': pd.to_datetime(pd.date_range(start='2023-01-01', periods=num_trips, freq='H'))\n",
        "}\n",
        "\n",
        "df_rides = pd.DataFrame(data)\n",
        "\n",
        "# Introduce some missing fare amounts\n",
        "missing_fare_indices = np.random.choice(df_rides.index, 3, replace=False)\n",
        "df_rides.loc[missing_fare_indices, 'fare_amount'] = np.nan\n",
        "\n",
        "# Display original DataFrame with issues\n",
        "print(\"Original Ride-Sharing DataFrame with introduced issues:\")\n",
        "display(df_rides.head(10))\n",
        "display(df_rides.isnull().sum())\n"
      ],
