      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "\n",
        "# Generate synthetic student performance data\n",
        "data = {\n",
        "    'student_id': range(1, 21),\n",
        "    'exam_date': pd.to_datetime(pd.date_range(start='2023-01-01', periods=20, freq='D')),\n",
        "    'subject': ['Math', 'Science', 'History', 'English'] * 5,\n",
        "    'total_marks': np.random.randint(40, 100, 20),\n",
        "    'attendance_percentage': np.random.uniform(70, 100, 20)\n",
        "}\n",
        "df_students = pd.DataFrame(data)\n",
        "\n",
        "# Introduce some outliers in total_marks\n",
        "df_students.loc[2, 'total_marks'] = 10\n",
        "df_students.loc[15, 'total_marks'] = 110\n",
        "\n",
        "print(\"Original Student Performance DataFrame with introduced issues:\")\n",
        "display(df_students)\n"
      ],
